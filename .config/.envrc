# This repo is worked on under the work Claude profile, but the cwd-based
# claude() wrapper in shell/aliases.sh maps ~/.config to personal. Pin it, so
# herdr's replayed `claude --resume <id>` finds the session.
#
# Needs a one-time `direnv allow ~/.config`, which yadm bootstrap runs.
export CLAUDE_CONFIG_DIR="$HOME/.claude/work"
