# This dotfiles repo is worked on under the *work* Claude profile, but it sits
# at ~/.config, which the cwd-based claude() wrapper in shell/aliases.sh would
# route to *personal*. Pin it explicitly.
#
# This is what makes herdr's agent restore correct here: on a server restart
# herdr replays `claude --resume <session-id>` into the pane, and the id only
# resolves under the profile that created it.
#
# Requires direnv (hooked in ~/.zshrc, installed by the Brewfile). Run
# `direnv allow ~/.config` once per machine; yadm bootstrap does this for you.
export CLAUDE_CONFIG_DIR="$HOME/.claude/work"
