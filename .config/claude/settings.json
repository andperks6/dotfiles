{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(brew *)",
      "Bash(grep *)",
      "Bash(gh api *)",
      "Bash(gh issue list*)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh pr status*)",
      "Bash(gh pr view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list*)",
      "Bash(gh run view *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(yadm *)",
      "Bash(mise *)",
      "Bash(npm run *)",
      "Bash(uv *)",
      "Read(~/.config/**)",
      "Read(~/.zshrc)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*credential*)"
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
"pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "devops-tools@claudekit-skills": true,
    "media-tools@claudekit-skills": true,
    "document-processing@claudekit-skills": true
  },
  "extraKnownMarketplaces": {
    "dev-browser-marketplace": {
      "source": {
        "source": "github",
        "repo": "sawyerhood/dev-browser"
      }
    },
    "claudekit-skills": {
