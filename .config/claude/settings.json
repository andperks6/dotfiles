  "permissions": {
    "allow": [
      "Bash(brew *)",
      "Bash(grep *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(yadm *)",
      "Bash(mise *)",
