# Ghostty configuration (XDG path, tracked in dotfiles).
# Loaded from $XDG_CONFIG_HOME/ghostty/config.ghostty before any
# macOS Application Support config. See https://ghostty.org/docs/config

# System-adaptive theme: follows macOS light/dark appearance.
theme = dark:Synthwave, light:Modus Operandi

# Always restore windows, tab order, and per-tab working directories on
# relaunch. Each restored tab re-runs the login shell, and shell/tmux.sh
# reattaches it to the detached tmux session matching its directory.
window-save-state = always

# ---- herdr: cmd+1..9 to switch workspaces ----
# herdr runs in one Ghostty tab holding every project, so cmd+N has to reach
# herdr rather than Ghostty. herdr binds ctrl+shift+1..9 (keys.switch_workspace);
# these forward cmd+N to it as CSI-u. csi: takes the sequence body, so
# 49..57 are '1'..'9' and 6 is the ctrl+shift modifier.
#
# Commented out while tmux and herdr run side by side, because enabling them
# removes Ghostty's own cmd+N tab switching. Uncomment once tmux is retired.
keybind = super+one=csi:49;6u
keybind = super+two=csi:50;6u
keybind = super+three=csi:51;6u
keybind = super+four=csi:52;6u
keybind = super+five=csi:53;6u
keybind = super+six=csi:54;6u
keybind = super+seven=csi:55;6u
keybind = super+eight=csi:56;6u
keybind = super+nine=csi:57;6u
