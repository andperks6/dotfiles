[user]
	name = Andrew Perkins
	email = andperks6@gmail.com
[includeIf "gitdir:~/dev/work/"]
	path = ~/.config/git/config-work
[core]
    autocrlf = input
    commentChar = ";"
    pager = delta -s
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
[merge]
    conflictstyle = zdiff3
[diff]
    colorMoved = default
[init]
	defaultBranch = main
