#!/bin/bash

bootstrap_dir=$(dirname $0)

bootstrap_deps() {
    if [[ -x "$(command -v brew)" ]]; then
        brew bundle --file "${bootstrap_dir}/Brewfile"
        brew pin tmux
    fi

    # Install Chrome for Testing (required by agent-browser)
    if [[ -x "$(command -v agent-browser)" ]]; then
        agent-browser install
    fi

    if [[ "$(uname -s)" == "Linux" && "$(uname -o)" != "Android" ]]; then
        wsl_sys32_path="/mnt/c/Windows/System32"
        if [[ ! -d $wsl_sys32_path ]]; then
            source "${bootstrap_dir}/wezterm.sh"
            source "${bootstrap_dir}/fonts.sh"
        fi
        sudo apt --yes update
    fi
}

bootstrap_mise_tools() {
    if [[ ! -x "$(command -v mise)" ]]; then
        echo "Warning: mise not installed, skipping tool installation"
        return
    fi
    # Install core tools only (versions defined in ~/.config/mise/config.toml)
    # Role-specific tools (java, kotlin, gradle, dotnet) installed via setup scripts
    mise install \
        bun \
        golang \
        k9s \
        kubectl \
        lua \
        nodejs \
        opentofu \
        python \
        ruby \
        rust \
        scala \
        terraform \
        uv \
        zig \
        zls
}

bootstrap_libraries() {
    if [[ ! -x "$(command -v mise)" ]]; then
        echo "Warning: mise not installed, skipping library installation"
        return
    fi

    bootstrap_python() {
        uv pip install --system -r ~/.config/lang/python/requirements.txt
    }

    bootstrap_rust() {
        cargo install aoc-cli
        mise reshim
    }

    bootstrap_node() {
        npm install -g npm
        corepack enable
    }

    bootstrap_tmux() {
        # Install TPM (Tmux Plugin Manager) if not present
        tpm_path="${HOME}/.tmux/plugins/tpm"
        if [[ ! -d "$tpm_path" ]]; then
            echo "Installing TPM (Tmux Plugin Manager)..."
            git clone https://github.com/tmux-plugins/tpm "$tpm_path"
        fi
        # Install plugins non-interactively
        if [[ -x "${tpm_path}/bin/install_plugins" ]]; then
            echo "Installing tmux plugins..."
            "${tpm_path}/bin/install_plugins"
        fi
    }

    bootstrap_python
    bootstrap_rust
    bootstrap_node
    bootstrap_tmux
}

bootstrap_crypt() {
    yadm decrypt
    source "${bootstrap_dir}/setup_git.sh"
}

# Run all bootstrap steps
bootstrap_deps
bootstrap_mise_tools
bootstrap_libraries
bootstrap_crypt

echo ""
echo "Bootstrap complete!"
echo ""
echo "Optional setup scripts available in ~/.config/yadm/setup/:"
echo "  jvm.sh    - Java, Kotlin, Gradle + IntelliJ"
echo "  dotnet.sh - .NET SDK"
echo "  mobile.sh - Flutter"
echo "  repos.sh  - Personal repositories"
