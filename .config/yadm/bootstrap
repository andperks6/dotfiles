#!/bin/bash

bootstrap_dir=$(dirname $0)

bootstrap_deps() {
    if [[ -x "$(command -v brew)" ]]; then
        brew bundle --file "${bootstrap_dir}/Brewfile"
        brew pin tmux
    fi

    # Install Chrome for Testing (required by agent-browser)
    if [[ -x "$(command -v agent-browser)" ]]; then
        agent-browser install
    fi

    if [[ "$(uname -s)" == "Linux" && "$(uname -o)" != "Android" ]]; then
        wsl_sys32_path="/mnt/c/Windows/System32"
        if [[ ! -d $wsl_sys32_path ]]; then
            source "${bootstrap_dir}/wezterm.sh"
            source "${bootstrap_dir}/fonts.sh"
        fi
        sudo apt --yes update
    fi
}

bootstrap_mise_tools() {
    if [[ ! -x "$(command -v mise)" ]]; then
        echo "Warning: mise not installed, skipping tool installation"
        return
    fi
    # Install core tools only (versions defined in ~/.config/mise/config.toml)
    # Role-specific tools (java, kotlin, gradle, dotnet) installed via setup scripts
    mise install \
        bun \
        golang \
        k9s \
        kubectl \
        lua \
        nodejs \
        opentofu \
        python \
        ruby \
        rust \
        scala \
        terraform \
        uv \
        zig \
        zls
}

bootstrap_libraries() {
    if [[ ! -x "$(command -v mise)" ]]; then
        echo "Warning: mise not installed, skipping library installation"
        return
    fi

    bootstrap_python() {
        uv pip install --system -r ~/.config/lang/python/requirements.txt
    }

    bootstrap_python_tools() {
        # CLI tools installed into isolated venvs under ~/.local/share/uv/tools
        # with shims in ~/.local/bin (added to PATH in shell/software.sh).
        uv tool install mlx-lm
    }

    bootstrap_rust() {
        cargo install aoc-cli
        mise reshim
    }

    bootstrap_node() {
        npm install -g npm
        corepack enable
    }

    bootstrap_tmux() {
        # Install TPM (Tmux Plugin Manager) if not present
        tpm_path="${HOME}/.tmux/plugins/tpm"
        if [[ ! -d "$tpm_path" ]]; then
            echo "Installing TPM (Tmux Plugin Manager)..."
            git clone https://github.com/tmux-plugins/tpm "$tpm_path"
        fi
        # Install plugins non-interactively
        if [[ -x "${tpm_path}/bin/install_plugins" ]]; then
            echo "Installing tmux plugins..."
            "${tpm_path}/bin/install_plugins"
        fi
    }

    bootstrap_python
    bootstrap_python_tools
    bootstrap_rust
    bootstrap_node
    bootstrap_tmux
}

bootstrap_crypt() {
    local archive="${HOME}/.local/share/yadm/archive"
    if [[ -f "$archive" ]]; then
        yadm decrypt
    else
        echo "Skipping yadm decrypt: no archive found at $archive"
    fi
}

bootstrap_claude_profiles() {
    # Set up work/personal Claude Code profiles under ~/.claude/. Each profile
    # dir symlinks shared config (settings, skills, hooks) back to ~/.claude/
    # but keeps its own auth, sessions, history, and project state.
    # To diverge a file, replace the symlink:
    #   rm ~/.claude/work/settings.json
    #   cp ~/.claude/settings.json ~/.claude/work/settings.json
    local claude_dir="${HOME}/.claude"
    local shared_items=(settings.json skills hooks .rgignore)

    mkdir -p "$claude_dir"
    for profile in work personal; do
        local profile_dir="${claude_dir}/${profile}"
        mkdir -p "$profile_dir"
        for item in "${shared_items[@]}"; do
            if [[ -e "${claude_dir}/${item}" ]] && [[ ! -e "${profile_dir}/${item}" ]]; then
                ln -s "../${item}" "${profile_dir}/${item}"
            fi
        done
    done
    echo "Claude profiles ready: ~/.claude/work, ~/.claude/personal"
    echo "  Log in per profile: 'claude-work' then /login, 'claude-personal' then /login"
}

bootstrap_daily_log() {
    # Install the daily Obsidian work/personal log scheduler (launchd on macOS,
    # systemd --user timer on Linux). Idempotent. Details in
    # ~/.config/claude/routines/ (install.sh, daily-log.sh, the plist).
    local installer="${HOME}/.config/claude/routines/install.sh"
    if [[ -x "$installer" ]]; then
        "$installer" || echo "Warning: daily-log install reported an issue (continuing)"
    else
        echo "Skipping daily-log: no installer at $installer"
    fi
}

# Plugin revisions, pinned so a new machine gets the versions tested here.
# herdr stores plugins outside this repo and has no lockfile, so the pin lives
# here. Bump deliberately, then re-run this function.
HERDR_PLUGIN_SESH_REF="45a85375d32521c2288305366a26672800bc3482"  # 0.12.0 + 4
HERDR_PLUGIN_FZF_URL_REF="9638f2d6dfeaf690995bf3caca7a37a7fd8e7dcc"

bootstrap_herdr() {
    # herdr itself comes from the Brewfile. This adds what brew cannot: plugins
    # (built from source) and the Claude hook behind `claude --resume`.
    # Idempotent.
    if ! command -v herdr >/dev/null 2>&1; then
        echo "Skipping herdr setup: herdr not installed"
        return
    fi

    # Plugins build from source. herdr-plugin-sesh needs Go >= 1.26, pinned in
    # ~/.config/mise/config.toml, so put mise's shims on PATH first.
    if command -v mise >/dev/null 2>&1; then
        eval "$(mise env -s bash 2>/dev/null)" || true
    fi

    local installed
    installed=$(herdr plugin list 2>/dev/null || true)

    # Replaces the tmux sesh picker (prefix+s) and `sesh last` (prefix+shift+L).
    # sesh has no herdr backend yet: joshmedeski/sesh#460.
    if ! printf '%s' "$installed" | grep -q "sesh"; then
        echo "Installing herdr-plugin-sesh..."
        herdr plugin install fullerzz/herdr-plugin-sesh --ref "$HERDR_PLUGIN_SESH_REF" -y \
            || echo "Warning: herdr-plugin-sesh install failed (needs git + Go >= 1.26); continuing"
    fi

    # Replaces wfxr/tmux-fzf-url (prefix+u).
    if ! printf '%s' "$installed" | grep -q "fzf-url"; then
        echo "Installing herdr-fzf-url..."
        herdr plugin install kaar/herdr-fzf-url --ref "$HERDR_PLUGIN_FZF_URL_REF" -y \
            || echo "Warning: herdr-fzf-url install failed; continuing"
    fi

    # Writes a SessionStart hook so herdr learns each pane's Claude session id
    # and can replay `claude --resume <id>` after a restart. Replaces
    # ~/.config/tmux/scripts/claude-pane-registry.sh.
    #
    # Once per *distinct* settings.json: bootstrap_claude_profiles symlinks the
    # work and personal files back to ~/.claude/settings.json, so installing per
    # directory would register the same hook three times and run it three times
    # per session. Dedupe on the resolved path, in case a profile ever diverges.
    local -a done_targets=()
    local profile_dir resolved already
    for profile_dir in "${HOME}/.claude" "${HOME}/.claude/work" "${HOME}/.claude/personal"; do
        [[ -d "$profile_dir" ]] || continue
        # Resolve through the symlink; fall back to the literal path if absent.
        resolved=$(cd "$profile_dir" 2>/dev/null && pwd -P)/settings.json
        [[ -e "${profile_dir}/settings.json" ]] && \
            resolved=$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' \
                       "${profile_dir}/settings.json" 2>/dev/null || echo "$resolved")
        already=0
        for t in "${done_targets[@]}"; do [[ "$t" == "$resolved" ]] && already=1; done
        (( already )) && continue
        done_targets+=("$resolved")
        CLAUDE_CONFIG_DIR="$profile_dir" herdr integration install claude >/dev/null 2>&1 \
            || echo "Warning: herdr claude integration failed for ${profile_dir}; continuing"
    done
    echo "herdr Claude integration installed (verify with: herdr integration status)"

    # ~/.config/.envrc pins this repo to the work Claude profile. direnv blocks
    # an unapproved .envrc, so approve it here.
    if command -v direnv >/dev/null 2>&1 && [[ -f "${HOME}/.config/.envrc" ]]; then
        direnv allow "${HOME}/.config" 2>/dev/null \
            || echo "Warning: could not direnv allow ~/.config; run it by hand"
    fi

    echo "herdr ready. Start it with 'herdr'; to restore workspaces at login:"
    echo "  brew services start herdr"
}

bootstrap_local_skills() {
    # Source-of-truth for agent-neutral skills tracked in dotfiles. Each entry
    # in ~/.config/skills/<name>/ is exposed to every installed agent via
    # symlink. Used for skills that skillkit cannot install unattended (e.g.
    # repos that fail its security scan or have a non-discoverable layout).
    local source_dir="${HOME}/.config/skills"
    if [[ ! -d "$source_dir" ]]; then
        echo "Skipping local skills: no ~/.config/skills directory"
        return
    fi
    local agent_dirs=(
        "${HOME}/.claude/skills"
        "${HOME}/.codex/skills"
        "${HOME}/.opencode/skills"
    )
    for skill_path in "${source_dir}"/*; do
        [[ -d "$skill_path" ]] || continue
        local name
        name=$(basename "$skill_path")
        for agent_skills in "${agent_dirs[@]}"; do
            [[ -d "$(dirname "$agent_skills")" ]] || continue
            mkdir -p "$agent_skills"
            local link="${agent_skills}/${name}"
            if [[ -L "$link" ]]; then
                # Refresh the symlink target if it drifted.
                [[ "$(readlink "$link")" == "$skill_path" ]] || ln -snf "$skill_path" "$link"
            elif [[ ! -e "$link" ]]; then
                ln -s "$skill_path" "$link"
            fi
        done
    done
    echo "Local skills linked from ~/.config/skills/"
}

bootstrap_skillkit() {
    # Restore community skills from the ~/.skills manifest.
    # Custom skills in ~/.config/skills/ are handled by bootstrap_local_skills.
    if [[ ! -f "${HOME}/.skills" ]]; then
        echo "Skipping skillkit: no ~/.skills manifest found"
        return
    fi
    if ! command -v npx >/dev/null 2>&1; then
        echo "Skipping skillkit: npx not installed"
        return
    fi
    echo "Installing community skills from ~/.skills manifest..."
    # skillkit resolves install scope from the cwd: it writes to
    # <cwd>/.claude/skills. Running from anywhere else (e.g. ~/.config)
    # creates a project-scoped duplicate set instead of user-scoped skills.
    ( cd "${HOME}" && npx -y skillkit@latest manifest install --yes )
}

# Run all bootstrap steps
bootstrap_deps
bootstrap_mise_tools
bootstrap_libraries
bootstrap_crypt
bootstrap_claude_profiles
bootstrap_daily_log
bootstrap_herdr
bootstrap_local_skills
bootstrap_skillkit

echo ""
echo "Bootstrap complete!"
echo ""
echo "Optional setup scripts available in ~/.config/yadm/setup/:"
echo "  jvm.sh    - Java, Kotlin, Gradle + IntelliJ"
echo "  dotnet.sh - .NET SDK"
echo "  mobile.sh - Flutter"
echo "  repos.sh  - Personal repositories"
