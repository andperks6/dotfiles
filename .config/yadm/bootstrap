#!/bin/bash

bootstrap_dir=$(dirname $0)

bootstrap_deps() {
    if [[ -x "$(command -v brew)" ]]; then
        brew bundle --file "${bootstrap_dir}/Brewfile"
        brew pin tmux
    fi

    # Install Chrome for Testing (required by agent-browser)
    if [[ -x "$(command -v agent-browser)" ]]; then
        agent-browser install
    fi

    if [[ "$(uname -s)" == "Linux" && "$(uname -o)" != "Android" ]]; then
        wsl_sys32_path="/mnt/c/Windows/System32"
        if [[ ! -d $wsl_sys32_path ]]; then
            source "${bootstrap_dir}/wezterm.sh"
            source "${bootstrap_dir}/fonts.sh"
        fi
        sudo apt --yes update
    fi
}

bootstrap_mise_tools() {
    if [[ ! -x "$(command -v mise)" ]]; then
        echo "Warning: mise not installed, skipping tool installation"
        return
    fi
    # Install core tools only (versions defined in ~/.config/mise/config.toml)
    # Role-specific tools (java, kotlin, gradle, dotnet) installed via setup scripts
    mise install \
        bun \
        golang \
        k9s \
        kubectl \
        lua \
        nodejs \
        opentofu \
        python \
        ruby \
        rust \
        scala \
        terraform \
        uv \
        zig \
        zls
}

bootstrap_libraries() {
    if [[ ! -x "$(command -v mise)" ]]; then
        echo "Warning: mise not installed, skipping library installation"
        return
    fi

    bootstrap_python() {
        uv pip install --system -r ~/.config/lang/python/requirements.txt
    }

    bootstrap_python_tools() {
        # CLI tools installed into isolated venvs under ~/.local/share/uv/tools
        # with shims in ~/.local/bin (added to PATH in shell/software.sh).
        uv tool install mlx-lm
    }

    bootstrap_rust() {
        cargo install aoc-cli
        mise reshim
    }

    bootstrap_node() {
        npm install -g npm
        corepack enable
    }

    bootstrap_tmux() {
        # Install TPM (Tmux Plugin Manager) if not present
        tpm_path="${HOME}/.tmux/plugins/tpm"
        if [[ ! -d "$tpm_path" ]]; then
            echo "Installing TPM (Tmux Plugin Manager)..."
            git clone https://github.com/tmux-plugins/tpm "$tpm_path"
        fi
        # Install plugins non-interactively
        if [[ -x "${tpm_path}/bin/install_plugins" ]]; then
            echo "Installing tmux plugins..."
            "${tpm_path}/bin/install_plugins"
        fi
    }

    bootstrap_python
    bootstrap_python_tools
    bootstrap_rust
    bootstrap_node
    bootstrap_tmux
}

bootstrap_crypt() {
    local archive="${HOME}/.local/share/yadm/archive"
    if [[ -f "$archive" ]]; then
        yadm decrypt
    else
        echo "Skipping yadm decrypt: no archive found at $archive"
    fi
}

bootstrap_claude_profiles() {
    # Set up work/personal Claude Code profiles under ~/.claude/. Each profile
    # dir symlinks shared config (settings, skills, hooks) back to ~/.claude/
    # but keeps its own auth, sessions, history, and project state.
    # To diverge a file, replace the symlink:
    #   rm ~/.claude/work/settings.json
    #   cp ~/.claude/settings.json ~/.claude/work/settings.json
    local claude_dir="${HOME}/.claude"
    local shared_items=(settings.json skills hooks .rgignore)

    mkdir -p "$claude_dir"
    for profile in work personal; do
        local profile_dir="${claude_dir}/${profile}"
        mkdir -p "$profile_dir"
        for item in "${shared_items[@]}"; do
            if [[ -e "${claude_dir}/${item}" ]] && [[ ! -e "${profile_dir}/${item}" ]]; then
                ln -s "../${item}" "${profile_dir}/${item}"
            fi
        done
    done
    echo "Claude profiles ready: ~/.claude/work, ~/.claude/personal"
    echo "  Log in per profile: 'claude-work' then /login, 'claude-personal' then /login"
}

bootstrap_local_skills() {
    # Source-of-truth for agent-neutral skills tracked in dotfiles. Each entry
    # in ~/.config/skills/<name>/ is exposed to every installed agent via
    # symlink. Used for skills that skillkit cannot install unattended (e.g.
    # repos that fail its security scan or have a non-discoverable layout).
    local source_dir="${HOME}/.config/skills"
    if [[ ! -d "$source_dir" ]]; then
        echo "Skipping local skills: no ~/.config/skills directory"
        return
    fi
    local agent_dirs=(
        "${HOME}/.claude/skills"
        "${HOME}/.codex/skills"
        "${HOME}/.opencode/skills"
    )
    for skill_path in "${source_dir}"/*; do
        [[ -d "$skill_path" ]] || continue
        local name
        name=$(basename "$skill_path")
        for agent_skills in "${agent_dirs[@]}"; do
            [[ -d "$(dirname "$agent_skills")" ]] || continue
            mkdir -p "$agent_skills"
            local link="${agent_skills}/${name}"
            if [[ -L "$link" ]]; then
                # Refresh the symlink target if it drifted.
                [[ "$(readlink "$link")" == "$skill_path" ]] || ln -snf "$skill_path" "$link"
            elif [[ ! -e "$link" ]]; then
                ln -s "$skill_path" "$link"
            fi
        done
    done
    echo "Local skills linked from ~/.config/skills/"
}

bootstrap_skillkit() {
    # Restore community skills from the ~/.skills manifest.
    # Custom skills in ~/.config/skills/ are handled by bootstrap_local_skills.
    if [[ ! -f "${HOME}/.skills" ]]; then
        echo "Skipping skillkit: no ~/.skills manifest found"
        return
    fi
    if ! command -v npx >/dev/null 2>&1; then
        echo "Skipping skillkit: npx not installed"
        return
    fi
    echo "Installing community skills from ~/.skills manifest..."
    npx -y skillkit@latest manifest install --yes
}

# Run all bootstrap steps
bootstrap_deps
bootstrap_mise_tools
bootstrap_libraries
bootstrap_crypt
bootstrap_claude_profiles
bootstrap_local_skills
bootstrap_skillkit

echo ""
echo "Bootstrap complete!"
echo ""
echo "Optional setup scripts available in ~/.config/yadm/setup/:"
echo "  jvm.sh    - Java, Kotlin, Gradle + IntelliJ"
echo "  dotnet.sh - .NET SDK"
echo "  mobile.sh - Flutter"
echo "  repos.sh  - Personal repositories"
