#!/bin/bash

bootstrap_dir=$(dirname $0)

bootstrap_deps() {
    if [[ -x "$(command -v brew)" ]]; then
        brew bundle --file "${bootstrap_dir}/Brewfile"
        brew pin tmux
        brew update
        brew upgrade
    fi

    if [[ "$(uname -s)" == "Linux" && "$(uname -o)" != "Android" ]]; then
        wsl_sys32_path="/mnt/c/Windows/System32"
        if [[ ! -d $wsl_sys32_path ]]; then
            source "${bootstrap_dir}/wezterm.sh"
            source "${bootstrap_dir}/fonts.sh"
        fi
        sudo apt --yes update
        sudo apt --yes upgrade
    fi
}

bootstrap_mise_tools() {
    if [[ ! -x "$(command -v mise)" ]]; then
        echo "Warning: mise not installed, skipping tool installation"
        return
    fi
    # Install all tools from mise config
    mise install

}

bootstrap_libraries() {
    if [[ ! -x "$(command -v mise)" ]]; then
        echo "Warning: mise not installed, skipping library installation"
        return
    fi

    bootstrap_python() {
        uv pip install -r ~/.config/lang/python/requirements.txt
    }

    bootstrap_rust() {
        cargo install aoc-cli
        mise reshim
    }
 
    bootstrap_node() {
        npm install -g npm
        corepack enable
        npm install -g neovim
    }
    
    bootstrap_java() {
        # macOS Java integration - link Java to system location for JAVA_HOME
        if [[ "$(uname -s)" == "Darwin" ]]; then
            # Get installed Java version from mise
            java_version=$(mise current java 2>/dev/null | awk '{print $2}')
            if [[ -n "$java_version" ]]; then
                java_install_path="${XDG_DATA_HOME}/mise/installs/java/${java_version}"
                java_system_path="/Library/Java/JavaVirtualMachines/mise-${java_version}.jdk"

                if [[ -d "$java_install_path/Contents" ]] && [[ ! -e "$java_system_path" ]]; then
                    echo "Setting up macOS Java integration for ${java_version}"
                    sudo mkdir -p "$java_system_path"
                    sudo ln -sf "$java_install_path/Contents" "$java_system_path/Contents"
                fi
            fi
        fi
    }

    bootstrap_python
    bootstrap_rust
    bootstrap_node
    bootstrap_java
}

bootstrap_crypt() {
    yadm decrypt
    source "${bootstrap_dir}/setup_git.sh"
}

bootstrap_repos() {
    if [[ -x "$(command -v ansible-playbook)" ]]; then
        ansible-playbook -vv "${bootstrap_dir}/setup-repos.yml"
    fi
}

case "${1:-all}" in
    all)
        bootstrap_deps
        bootstrap_mise_tools
        bootstrap_libraries
        bootstrap_crypt
        bootstrap_repos
        ;;
    deps|brew)
        bootstrap_deps
        ;;
    mise|tools)
        bootstrap_mise_tools
        ;;
    libs|libraries)
        bootstrap_libraries
        ;;
    crypt)
        bootstrap_crypt
        ;;
    repos)
        bootstrap_repos
        ;;
    asdf)
        echo "Warning: no more asdf, use 'mise' instead"
        bootstrap_mise_tools
        ;;
    *)
        echo "Usage: yadm bootstrap [command]"
        echo "Commands: deps, mise, libs, crypt, repos (default: all)"
        exit 1
        ;;
esac
